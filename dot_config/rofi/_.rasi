* {
  font: "Montserrat 12";

  bg0: #00000099;
  bg1: #FFFFFF20;
  bg2: #FFFFFF30;
  bd0: #ffffff33;
  fg0: #FFFFFF;
  fg1: #FFFFFF;
  fg2: #FFFFFF80;

  background-color: transparent;
  text-color: @fg0;
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 400px;
  location: center;
}

mainbox {
  spacing: 20px;
  children: [ input-wrapper, listview ];
}

input-wrapper, listview {
  background-color: @bg0;
  border: 1px;
  border-color: @bd0;
  border-radius: 12px;
}

input-wrapper {
  orientation: vertical;
  padding: 12px;
  spacing: 12px;
  children: [ inputbar, message ];
  expand: false;
}

inputbar {
  children: [ entry ];
}

entry {
  font: "Montserrat 20";
  placeholder-color: @fg2;
  horizontal-align: 0.5;
}

textbox {
  text-color: @fg0;
  horizontal-align: 0.5;
}

message {
  expand: false;
}

listview {
  lines: 10;
  columns: 1;
  fixed-height: false;
  dynamic: true;
}

element {
  padding: 8px;
  spacing: 16px;
}

element selected {
  background-color: @bg2;
  text-color: @fg1;
}

element-icon, element-text {
  size: 1.5em;
  vertical-align: 0.5;
  text-color: inherit;
}
