(defpoll time :interval "1s" "date '+%H:%M:%S'")
(defpoll date :interval "1s" "date '+%u/7 %d.%m.%Y'")

;; --- Widgets ---

(defwidget clock_widget []
  (box :orientation "v"
       :class "clock-container"
       :space-evenly false
    (label :class "clock-label" :text time)
    (label :class "date-label"  :text date)
  )
)

(defwidget calendar_widget []
  (box :orientation "v"
       :class "cal-container"
    (calendar :class "cal-widget"
              :show-details true
              :active false)
  )
)

;; --- Unified Container ---

(defwidget main_widget []
  (box :orientation "v"
       :space-evenly false
       :class "main-container"
       :spacing 15
    (clock_widget)
    (calendar_widget)
  )
)

;; --- Window ---

(defwindow main
  :monitor 0
  :stacking "bottom"
  :geometry (geometry :x "30px"
                      :y "30px"
                      :width "400px"
                      :anchor "right bottom")
  (main_widget))