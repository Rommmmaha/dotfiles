# =======================================================================================
# Variables
# =======================================================================================
input {
  kb_layout = us, ua
  kb_options = grp:caps_toggle,fkeys:basic_13-24
  numlock_by_default = true
}
general {
  allow_tearing = true
  gaps_in = 0
  gaps_out = 0
  border_size = 0
  layout = dwindle
  resize_on_border = false
  snap {
    enabled = true
    window_gap = 25
    monitor_gap = 25
  }
}
decoration {
  shadow {
    sharp = true
    range = 1
    color = rgba(ffffff33)
  }
  blur {
    size = 2
    passes = 3
    new_optimizations = true
    noise = 0
  }
}
animations {
  enabled = no
  bezier = fluent_decel, 0, 0.2, 0.4, 1
  bezier = easeOutExpo, 0.16, 1, 0.3, 1
  animation = windows, 1, 3, fluent_decel, popin 80%
  animation = windowsIn, 1, 3, easeOutExpo, popin 60%
  animation = windowsOut, 1, 3, fluent_decel, popin 80%
  animation = border, 1, 10, default
  animation = fade, 1, 3, default
  animation = workspaces, 1, 3.5, easeOutExpo, slide
  animation = specialWorkspace, 1, 3, fluent_decel, slidevert
}
misc {
  disable_hyprland_logo = true
  disable_splash_rendering = true
  background_color = 0
  render_unfocused_fps = 30
}
binds {
  hide_special_on_workspace_change = true
  scroll_event_delay = 0
}
group:groupbar {
  indicator_height = 0
  text_color_inactive = 0x66ffffff
  font_size = 11
  gaps_in = 0
  gaps_out = 0
}
xwayland:force_zero_scaling = true
ecosystem {
  no_update_news = true
  no_donation_nag = true
}
render:cm_enabled = false
# =======================================================================================
# Autostart
# =======================================================================================
exec-once = dbus-update-activation-environment --systemd --all
exec-once = systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = hyprpaper
exec-once = systemctl --user start hyprpolkitagent
exec-once = eww open main
exec-once = kdeconnectd
exec-once = wl-clip-persist --clipboard regular
exec-once = wl-paste --watch clipvault store
exec-once = kitty --single-instance --start-as=hidden
# =======================================================================================
# Keybinds
# =======================================================================================
$configPath = $HOME/.config/hypr

# General
bind = Super, Return, exec, kitty --single-instance
bind = Super, E, exec, dolphin
bind = Super, X, exec, code -nq
bind = Super, C, exec, pwvucontrol
#bind = Super, C, exec, kitty --class pipemixer -e pipemixer
bindl = Shift, Escape, exec, playerctl play-pause
bind = Super, Backspace, exec, hyprctl keyword animations:enabled $(hyprctl getoption animations:enabled | grep -q "int: 1" && echo 0 || echo 1)

# Screenshot
bindi = , Print, exec, flameshot gui
bind = Super Shift, S, exec, flameshot gui
bind = Super, P, exec, [float] zsh -c 'exec oculante "$(print -r -- $HOME/Pictures/Screenshots/*(om[1]))"'

# Rofi
bind = Super, S, exec, rofi -show drun -show-icons
bind = Super, D, exec, rofi -show window -show-icons
bind = Super, Period, exec, rofimoji
bind = , XF86Calculator, exec, rofi -show calc -modi calc -no-show-match -no-sort
bind = Super, V, exec, rofi -modi clipboard:$configPath/custom/_clipvault.sh -show clipboard -show-icons

# Session
bind = Super, Escape, exit
bind = , XF86PowerOff, exit
bind = Super, L, exec, hyprlock

# Window managament
bind = Super, W, killactive,
bind = Super, F, togglefloating,
bind = Super, A, fullscreen, 1
bind = Super, G, togglegroup
bind = Super, Tab, cyclenext,
bind = Super, Tab, bringactivetotop,

# Workspaces
bind = Super, 1, workspace, 1
bind = Super, 2, workspace, 2
bind = Super, 3, workspace, 3
bind = Super, 4, workspace, 4
bind = Super, 5, workspace, 5
bind = Super, 6, workspace, 6
bind = Super, 7, workspace, 7
bind = Super, 8, workspace, 8
bind = Super, 9, workspace, 9
bind = Super, 0, workspace, 10

# Move to workspaces
bind = Super Shift, 1, movetoworkspacesilent, 1
bind = Super Shift, 2, movetoworkspacesilent, 2
bind = Super Shift, 3, movetoworkspacesilent, 3
bind = Super Shift, 4, movetoworkspacesilent, 4
bind = Super Shift, 5, movetoworkspacesilent, 5
bind = Super Shift, 6, movetoworkspacesilent, 6
bind = Super Shift, 7, movetoworkspacesilent, 7
bind = Super Shift, 8, movetoworkspacesilent, 8
bind = Super Shift, 9, movetoworkspacesilent, 9
bind = Super Shift, 0, movetoworkspacesilent, 10

# Workspaces (8-10)
bind = Super, GRAVE, exec, r_multitool ws 8
bind = Super, Q, exec, r_multitool ws 9
bind = Super, Z, exec, r_multitool ws 10

# Move to workspaces (8-10)
bind = Super Shift, GRAVE, movetoworkspacesilent, 8
bind = Super Shift, Q, movetoworkspacesilent, 9
bind = Super Shift, Z, movetoworkspacesilent, 10

# Move window
bind = Super CTRL, LEFT, movewindow, l
bind = Super CTRL, RIGHT, movewindow, r
bind = Super CTRL, UP, movewindow, u
bind = Super CTRL, DOWN, movewindow, d

# Brightness keys
bindel = , XF86MonBrightnessUp, exec, brightnessctl set 10%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 10%-

# Mouse binds
bindm = Super, mouse:272, movewindow
bindm = Super, mouse:273, resizewindow
# =======================================================================================
# Window Rules
# =======================================================================================
# Shadow only for floating
windowrule = match:float false, no_shadow on

# Floating windows
windowrule = match:class xdg-desktop-portal-gtk, float on
windowrule = match:class org\.freedesktop\.impl\.portal\.desktop\.kde, float on

# Pipemixer
windowrule {
  name = volume-menu
  match:class = pipemixer|com\.saivert\.pwvucontrol
  float = on
  size = 860 540
  center = on
}

# Flameshot
windowrule {
  name = flameshot
  match:title = flameshot
  float = on
  size = 1920 1080
  move = 0 0
  pin = on
  stay_focused = on
}

# Steam window tiling
windowrule = match:class steam, suppress_event maximize fullscreen

# Games
windowrule = match:class gamescope, tag +game
windowrule = match:class mcpelauncher-client, tag +game
windowrule = match:class steam_app_.*, tag +game
windowrule = match:class Minecraft.*, tag +game
windowrule {
  name = game
  match:tag = game
  tile = on
  opaque = on
  force_rgbx = on
  render_unfocused = on
  immediate = on
}
# =======================================================================================
# Layer Rules
# =======================================================================================
layerrule = match:namespace swaync-(notification-window|control-center)|rofi|gtk-layer-shell, blur on
layerrule = match:namespace swaync-(notification-window|control-center)|rofi|gtk-layer-shell, ignore_alpha 0
# =======================================================================================
# Device Specific Rules
# =======================================================================================
{{- if and .isAuthor (has .deviceType (list "pc" "laptop")) }}
source = $configPath/custom/hyprland-{{ .deviceType }}.conf
{{- end }}