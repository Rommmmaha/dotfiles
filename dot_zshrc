# ==============================================================================
# PLUGIN MANAGER (ZINIT) & PLUGINS
# ==============================================================================
ZINIT_FILE="$HOME/.local/share/zinit/zinit.git/zinit.zsh"
if [[ -f "$ZINIT_FILE" ]]; then
  source "$ZINIT_FILE"
else
  NO_EDIT=1 NO_INPUT=1 bash -c "$(curl --fail --show-error --silent --location https://raw.githubusercontent.com/zdharma-continuum/zinit/HEAD/scripts/install.sh)"
  zsh -ic "zinit self-update"
  exec zsh
fi
zinit wait"0" lucid for \
  zsh-users/zsh-syntax-highlighting \
  zsh-users/zsh-completions \
  zsh-users/zsh-autosuggestions \
  zsh-users/zsh-history-substring-search \
  Aloxaf/fzf-tab
# ==============================================================================
# COMPLETION SYSTEM INITIALIZATION
# ==============================================================================
autoload zmv
autoload -Uz compinit && compinit
zinit cdreplay -q
# ==============================================================================
# HISTORY SETTINGS
# ==============================================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=500
SAVEHIST=500
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
# ==============================================================================
# COMPLETION STYLING & FZF-TAB
# ==============================================================================
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' fzf-flags\
  --color=fg:-1,fg+:#000000,bg:-1,bg+:#ffffff\
  --color=hl:#00ff00,hl+:#000000,info:#00ff00,marker:#000000\
  --color=prompt:#ffffff,spinner:#ffffff,pointer:#000000,header:#87afaf\
  --color=border:#ffffff,label:#aeaeae,query:#d9d9d9\
  --preview-window="border-double" --prompt="> " --marker="->" --pointer=""\
  --separator="─" --scrollbar="╠"
# ==============================================================================
# KEYBINDINGS
# ==============================================================================
bindkey -e
bindkey -s '^V' ''
bindkey "^[[3~" delete-char
bindkey '^[[3;5~' kill-word
bindkey '^H' backward-kill-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
# ==============================================================================
# ENVIRONMENT VARIABLES & TOOL INIT
# ==============================================================================
export NEWT_COLORS="$(< $HOME/.config/NEWT_COLORS.ini)"

[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
eval "$(direnv hook zsh)"
eval "$(starship init zsh)"
# ==============================================================================
# ALIASES & FUNCTIONS
# ==============================================================================
alias edit=$EDITOR
alias nano=$EDITOR
alias C="wl-copy"

alias c="code"
alias ff="fastfetch --config simple"
alias icat="kitty +kitten icat"
alias matrix="cmatrix -C white"
alias nscan='sudo nmap -sS -T4 -Pn -n --min-rate 1000 --max-retries 2'

alias rm="trash"
alias ls="eza --icons --group-directories-first"
alias cat="bat --paging=never"
alias tree="ls -T"
alias clear="printf '\033[2J\033[3J\033[1;1H'"

t() {
  kitty "$@" </dev/null >/dev/null &!
}
o() {
  xdg-open "$@" </dev/null >/dev/null &!
}
qr() {
  qrencode -s 15 -o - "$@" | feh -
}
r_env() {
  local has=0
  for arg in "$@"; do [ "$arg" = "--" ] && has=1; done
  if [ "$has" -eq 1 ]; then
    command r_env "$@"
  else
    eval "$(command r_env "$@")"
  fi
}
# ==============================================================================
# TAB COMPLETIONS
# ==============================================================================
_gamescope() {
  local sep=${words[(i)--]}
  if (( sep < CURRENT )); then
    compset -n $sep
    _precommand
  fi
}

compdef _files o
compdef _files trash
compdef _precommand gamemoderun
compdef _precommand r_game.py
compdef _gamescope gamescope