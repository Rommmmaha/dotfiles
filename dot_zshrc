export ZSH="$HOME/.oh-my-zsh"
export NEWT_COLORS="$(< $HOME/.config/NEWT_COLORS.ini)"
plugins=(git archlinux zsh-autosuggestions)

source "$ZSH/oh-my-zsh.sh"
source "/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

bindkey '^H' backward-kill-word

alias c="code"
alias ls="eza --icons --group-directories-first"
alias cat="bat --paging=never"
alias tree="ls -T"
alias matrix="neo-matrix -D -c cyan"
alias clear="printf '\033[2J\033[3J\033[1;1H'"
alias _nmap='sudo nmap -T5 -n'
alias edit=$EDITOR
alias nano=$EDITOR

update() {
  sudo -v
  command -v hblock >/dev/null && hblock -q
  command -v yay >/dev/null && yay -Syu && yay -Yc
  command -v flatpak >/dev/null && flatpak update -y && flatpak remove --unused -y
  command -v bun >/dev/null && bun upgrade && bun update -g
}
qr() {
  qrencode -s 15 -o - "$@" | feh -
}

eval "$(starship init zsh)"
