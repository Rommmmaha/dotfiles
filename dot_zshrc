# ==============================================================================
# PLUGIN MANAGER (ZINIT) & PLUGINS
# ==============================================================================
source "/usr/share/zinit/zinit.zsh"
zinit wait"0" lucid for \
  zsh-users/zsh-syntax-highlighting \
  zsh-users/zsh-completions \
  zsh-users/zsh-autosuggestions \
  Aloxaf/fzf-tab
# ==============================================================================
# COMPLETION SYSTEM INITIALIZATION
# ==============================================================================
autoload zmv
autoload -Uz compinit && compinit
zinit cdreplay -q
# ==============================================================================
# HISTORY SETTINGS
# ==============================================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=500
SAVEHIST=500
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
# ==============================================================================
# COMPLETION STYLING & FZF-TAB
# ==============================================================================
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:bat:*' fzf-preview 'cat $realpath'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --icons --group-directories-first -1 $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza --icons --group-directories-first -1 $realpath'
zstyle ':fzf-tab:*' fzf-flags --color=fg:-1,fg+:#000000,bg:-1,bg+:#ffffff --color=hl:#ffffff,hl+:#000000,info:#afaf87,marker:#000000 --color=prompt:#ffffff,spinner:#ffffff,pointer:#000000,header:#87afaf --color=border:#ffffff,label:#aeaeae,query:#d9d9d9 --border-label="" --preview-window="border-rounded" --prompt="> " --marker=">" --pointer=">" --separator="─" --scrollbar="|"
# ==============================================================================
# KEYBINDINGS
# ==============================================================================
bindkey -e
bindkey "^[[3~" delete-char
bindkey '^[[3;5~' kill-word
bindkey '^H' backward-kill-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
# ==============================================================================
# ENVIRONMENT VARIABLES & TOOL INIT
# ==============================================================================
export NEWT_COLORS="$(< $HOME/.config/NEWT_COLORS.ini)"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

eval "$(fzf --zsh)"
eval "$(zoxide init --cmd cd zsh)"
eval "$(direnv hook zsh)"
eval "$(starship init zsh)"
# ==============================================================================
# ALIASES & FUNCTIONS
# ==============================================================================
alias c="code"
alias ls="eza --icons --group-directories-first"
alias ff="fastfetch --config simple"
alias cat="bat --paging=never"
alias icat="kitty +kitten icat"
alias tree="ls -T"
alias matrix="neo-matrix -D -c yellow"
alias clear="printf '\033[2J\033[3J\033[1;1H'"
alias nscan='sudo nmap -sS -T4 -Pn -n --min-rate 1000 --max-retries 2'
alias edit=$EDITOR
alias nano=$EDITOR
alias C="wl-copy"

o() {
  xdg-open "$@" > /dev/null 2>&1 &!
}
qr() {
  qrencode -s 15 -o - "$@" | feh -
}
upgrade() {
  sudo -v
  command -v hblock >/dev/null && hblock -q
  command -v yay >/dev/null && yay -Syu && yay -Yc
  command -v flatpak >/dev/null && flatpak update -y && flatpak remove --unused -y
  command -v bun >/dev/null && bun upgrade && bun update -g
}