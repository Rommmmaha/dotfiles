  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#646464"
      }
    },
    {
      "name": "Punctuation & Operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#969696"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "storage.type",
        "control.elements"
      ],
      "settings": {
        "foreground": "#42b6f0"
      }
    },
    {
      "name": "Functions & Variables",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable",
        "variable.other",
        "variable.language",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eeeeee"
      }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#259df4"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#28bd73"
      }
    },
    {
      "name": "Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#a770c2"
      }
    },
    {
      "name": "Object Keys, Properties & Tags",
      "scope": [
        "meta.object-literal.key",
        "entity.name.tag",
        "support.type.property-name",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#969696"
      }
    }
  ]
}